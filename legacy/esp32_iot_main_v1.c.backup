static void extract_features(const float *x,
		const float *y,
		const float *z,
		float *f)
{
	float magnitude[WINDOW_SAMPLES];

	float x_sum = 0.0f;
	float y_sum = 0.0f;
	float z_sum = 0.0f;
	float mag_sum = 0.0f;
	float mag_sq_sum = 0.0f;

	/* --------------------------------------------------------
	 * Calculate magnitude and basic sums
	 * -------------------------------------------------------- */

	for (int i = 0; i < WINDOW_SAMPLES; i++) {
		magnitude[i] = sqrtf(
				x[i] * x[i] +
				y[i] * y[i] +
				z[i] * z[i]
				);

		x_sum += x[i];
		y_sum += y[i];
		z_sum += z[i];

		mag_sum += magnitude[i];
		mag_sq_sum += magnitude[i] * magnitude[i];
	}

	/* --------------------------------------------------------
	 * Means
	 * -------------------------------------------------------- */

	float x_mean = x_sum / WINDOW_SAMPLES;
	float y_mean = y_sum / WINDOW_SAMPLES;
	float z_mean = z_sum / WINDOW_SAMPLES;
	float mag_mean = mag_sum / WINDOW_SAMPLES;

	/* --------------------------------------------------------
	 * Min/max initialization
	 * -------------------------------------------------------- */

	float x_min = x[0];
	float x_max = x[0];

	float y_min = y[0];
	float y_max = y[0];

	float z_min = z[0];
	float z_max = z[0];

	float mag_min = magnitude[0];
	float mag_max = magnitude[0];

	/* --------------------------------------------------------
	 * Min/max
	 * -------------------------------------------------------- */

	for (int i = 1; i < WINDOW_SAMPLES; i++) {

		if (x[i] < x_min) {
			x_min = x[i];
		}

		if (x[i] > x_max) {
			x_max = x[i];
		}

		if (y[i] < y_min) {
			y_min = y[i];
		}

		if (y[i] > y_max) {
			y_max = y[i];
		}

		if (z[i] < z_min) {
			z_min = z[i];
		}

		if (z[i] > z_max) {
			z_max = z[i];
		}

		if (magnitude[i] < mag_min) {
			mag_min = magnitude[i];
		}

		if (magnitude[i] > mag_max) {
			mag_max = magnitude[i];
		}
	}

	/* --------------------------------------------------------
	 * Variance
	 * -------------------------------------------------------- */

	float x_var = 0.0f;
	float y_var = 0.0f;
	float z_var = 0.0f;
	float mag_var = 0.0f;

	for (int i = 0; i < WINDOW_SAMPLES; i++) {

		float x_diff = x[i] - x_mean;
		float y_diff = y[i] - y_mean;
		float z_diff = z[i] - z_mean;
		float mag_diff = magnitude[i] - mag_mean;

		x_var += x_diff * x_diff;
		y_var += y_diff * y_diff;
		z_var += z_diff * z_diff;
		mag_var += mag_diff * mag_diff;
	}

	/* --------------------------------------------------------
	 * 18 features
	 *
	 * Must remain in exactly the same order as the
	 * features used when training the decision tree.
	 * -------------------------------------------------------- */

	f[0]  = x_mean;
	f[1]  = sqrtf(x_var / WINDOW_SAMPLES);
	f[2]  = x_min;
	f[3]  = x_max;

	f[4]  = y_mean;
	f[5]  = sqrtf(y_var / WINDOW_SAMPLES);
	f[6]  = y_min;
	f[7]  = y_max;

	f[8]  = z_mean;
	f[9]  = sqrtf(z_var / WINDOW_SAMPLES);
	f[10] = z_min;
	f[11] = z_max;

	f[12] = mag_mean;
	f[13] = sqrtf(mag_var / WINDOW_SAMPLES);
	f[14] = mag_min;
	f[15] = mag_max;

	f[16] = sqrtf(mag_sq_sum / WINDOW_SAMPLES);
	f[17] = mag_max - mag_min;
}

/* ============================================================
 * MAIN EXECUTION
 * ============================================================ */

void app_main(void) {
	esp_err_t ret = nvs_flash_init();
	if (ret == ESP_ERR_NVS_NO_FREE_PAGES || ret == ESP_ERR_NVS_NEW_VERSION_FOUND) {
		ESP_ERROR_CHECK(nvs_flash_erase());
		ret = nvs_flash_init();
	}
	ESP_ERROR_CHECK(ret);

	wifi_init_sta();
	aws_iot_init();

	i2c_init();
	if (adxl_init() != ESP_OK) {
		ESP_LOGE(TAG, "ADXL345 init failed");
		return;
	}

	float x[WINDOW_SAMPLES], y[WINDOW_SAMPLES], z[WINDOW_SAMPLES];
	float features[NUM_FEATURES];
	int64_t next_sample = esp_timer_get_time();

	while (1) {
		for (int i = 0; i < WINDOW_SAMPLES; i++) {
			if (adxl_read_accel(&x[i], &y[i], &z[i]) != ESP_OK) {
				x[i] = y[i] = z[i] = 0.0f;
			}
			next_sample += SAMPLE_PERIOD_MS * 1000;
			int64_t delay_us = next_sample - esp_timer_get_time();
			if (delay_us > 0) {
				vTaskDelay(pdMS_TO_TICKS(delay_us / 1000));
			} else {
				next_sample = esp_timer_get_time();
			}
		}

		extract_features(x, y, z, features);
		int result = pothole_predict(features);

		if (result == CLASS_POTHOLE) {
			ESP_LOGW(TAG, "POTHOLE DETECTED!");

			// Mock coordinates (e.g. 12.9716° N, 79.1588° E)
			float latitude = 12.9716f;
			float longitude = 79.1588f;

			char payload[128];
			snprintf(payload, sizeof(payload), "{\"event\":\"POTHOLE\",\"coordinates\":[%.4f,%.4f]}", latitude, longitude);

			if (mqtt_connected) {
				int msg_id = esp_mqtt_client_publish(mqtt_client, AWS_IOT_TOPIC, payload, 0, 1, 0);
				ESP_LOGI(TAG, "Published alert (msg_id=%d): %s", msg_id, payload);
			} else {
				ESP_LOGE(TAG, "AWS MQTT not connected, skipping publish");
			}
		}
	}
}

