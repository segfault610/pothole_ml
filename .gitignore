# ESP-IDF build output / generated config
build/
**/build/
managed_components/
sdkconfig
sdkconfig.old

# Secrets — never commit these (see docs/06-security.md)
**/certs/*.pem
**/certs/*.crt
**/certs/*.key
esp32_iot/main/secrets.h
cloud/.aws-sam/
cloud/samconfig.toml

# Python
__pycache__/
*.pyc
.venv/
ml/_native/
*.egg-info/

# Local data that should stay local
data/raw/*.local.csv
data/synthetic/
# bench (hand-motion) recordings: accelerometer data is committed so the
# deployed model can be rebuilt; GPS logs stay local (they reveal where you
# recorded), as do corrupt sessions and regenerable outputs
data/**/*.gps.csv
data/bench/excluded/
data/bench/model.h
data/bench/report.md
data/bench_aug/
